VITE_API_BASE_URL=http://localhost:8080/api/...

# Google Maps Platform - browser key, restricted by HTTP referrer to this app's
# origin(s), with only the Maps JavaScript API (and Places, if used) enabled.
# See README.md "Google Maps Setup" for how to create one. Without this set,
# the pharmacy locator map shows a "couldn't load" state but the rest of the
# app is unaffected.
VITE_GOOGLE_MAPS_API_KEY=

