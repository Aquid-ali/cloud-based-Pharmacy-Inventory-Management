# Server
NODE_ENV=development
PORT=5001

# MongoDB
MONGO_URI=mongodb+srv://aquid-ali:medichain@cluster0.touvqpj.mongodb.net/

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Admin provisioning (used only by `npm run seed:admin` — never exposed via a public API).
# Every Admin is scoped to one Store; run `npm run seed:stores` first, then `npm run seed:admin`
# to create one Admin per store, all sharing this password.
ADMIN_PASSWORD=replace_with_a_strong_password

# AI-powered medicine information enrichment (server-side only — never exposed
# to the frontend). Optional: without ANTHROPIC_API_KEY set, enrichment
# endpoints work but every attempt records enrichmentStatus "failed" with a
# clear "AI provider is not configured" reason instead of erroring.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Google Maps Platform - SERVER-SIDE key, distinct from the browser key in
# client/.env.example. Restrict this one by IP (not HTTP referrer) and enable
# only the Geocoding API. Used by `npm run geocode:pharmacies` (one-time
# backfill script) AND live by PUT /api/pharmacies/:id whenever an admin
# changes their pharmacy's address - the new address is re-geocoded and
# saved in the same request. Without this set, pharmacy address edits are
# rejected with a clear error rather than silently skipping the location update.
GOOGLE_MAPS_API_KEY=
